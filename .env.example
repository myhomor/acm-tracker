# Скопировать в .env и поправить ДО первого запуска: владелец создаётся один раз,
# при пустой базе. Потом имя и ставка меняются только в Settings → Members & rates.

# Порт трекера на хосте. 5188 — порт по умолчанию у MCP-плагина,
# поэтому плагин работает без ACM_API_URL.
ACM_PORT=5188

# Папка с данными трекера (база acm.db и uploads). Переживает удаление
# контейнера и образа. Лучше держать внутри WSL, не на /mnt/c.
ACM_DATA_DIR=./data

# От какого пользователя работает трекер: владелец файлов в ACM_DATA_DIR.
# Узнать свои значения: команды `id -u` и `id -g`.
ACM_UID=1000
ACM_GID=1000

# Часовой пояс сервера: от него считаются «сегодня» и «эта неделя».
ACM_TZ=Europe/Moscow

# Владелец (локальный пользователь без авторизации).
OWNER_NAME="Harry G."
OWNER_RATE_PER_HOUR=0
# По этому email MCP-сервер привязывает записи агента (ACM_OWNER_EMAIL).
# Если меняешь — поменяй и ACM_OWNER_EMAIL в .mcp.json.
OWNER_EMAIL=owner@acm.local
