# Данные трекера: база acm.db и загрузки — рабочие данные, не код
/data/
/data-backup-*/

# Локальные настройки с личными путями и данными — в репозитории лежат *.example-версии
.env
.mcp.json
.claude/settings.local.json
/hooks/config.json

# Состояние хука: сессии, очередь неотправленных записей, кэш id, занятые отрезки, лог
/hooks/state/

# Исходники трекера — отдельный git-репозиторий (клон upstream с локальными правками)
/acm-tracker/

# Система и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
