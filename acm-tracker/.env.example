# Database backend selector: "sqlite" (default, single-user, no server) or "postgres".
DB_BACKEND=sqlite

# SQLite (default distribution) — local file, no server, resolved under apps/api/prisma/sqlite/.
# DATABASE_URL is optional for sqlite; it defaults to file:./acm.db.
DATABASE_URL="file:./acm.db"

# Postgres (set DB_BACKEND=postgres) — fill with your server's connection string:
# DB_BACKEND=postgres
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/acm_tracker?schema=public&sslmode=require"

# Ports
API_PORT=4000
WEB_PORT=5173

# Single-origin / serving (packaging)
# WEB_DIST_DIR: when set, the API serves this static front build at "/" (API stays under "/api").
# WEB_DIST_DIR=apps/web/dist
# CORS_ORIGIN: only the 2-service mode needs it (web + api on different origins).
# Unset = no CORS (single-origin image). Accepts "*" or a comma-separated allowlist.
# CORS_ORIGIN=http://localhost:5173
# UPLOADS_DIR: uploaded files directory. Local default apps/api/uploads; single image uses /data/uploads.
# UPLOADS_DIR=apps/api/uploads

# Local owner (used by NoAuthProvider until a real auth provider is enabled)
OWNER_NAME="Harry G."
OWNER_EMAIL="owner@acm.local"
OWNER_RATE_PER_HOUR=45
