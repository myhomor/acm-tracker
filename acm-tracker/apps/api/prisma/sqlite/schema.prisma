generator client {
  provider = "prisma-client-js"
  output   = "./.generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  role               String        @default("member")
  ratePerHour        Float         @default(0)
  authProviderUserId String?       @unique
  createdAt          DateTime      @default(now())
  timeEntries        TimeEntry[]
  timerSession       TimerSession?
}

model Project {
  id             String   @id @default(cuid())
  name           String
  client         String?
  contractAmount Float?
  estimateHours  Float?
  ratePerHour    Float?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  tasks          Task[]
}

model Task {
  id              String         @id @default(cuid())
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  code            String
  title           String
  phase           String?
  summary         String?
  status          String         @default("todo")
  estimateMinutes Int?
  createdAt       DateTime       @default(now())
  timeEntries     TimeEntry[]
  timerSessions   TimerSession[]

  @@unique([projectId, code])
}

model TimeEntry {
  id                  String   @id @default(cuid())
  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId              String
  member              Member   @relation(fields: [memberId], references: [id])
  memberId            String
  origin              String   @default("manual")
  minutes             Int
  billable            Boolean  @default(true)
  ratePerHourSnapshot Float
  note                String?
  startedAt           DateTime
  createdAt           DateTime @default(now())
  aiRuns              AiRun[]

  @@index([taskId])
  @@index([memberId])
}

model AiRun {
  id          String    @id @default(cuid())
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  timeEntryId String
  agent       String?
  model       String
  tokensIn    Int
  tokensOut   Int
  costUsd     Float
  createdAt   DateTime  @default(now())

  @@index([timeEntryId])
}

model WorkspaceSettings {
  id              Int     @id @default(1)
  authProvider    String  @default("none")
  authConfig      String?
  dailyCostTarget Float   @default(2400)
}

model ModelPrice {
  id          String   @id @default(cuid())
  provider    String
  model       String
  inputPer1M  Float
  outputPer1M Float
  createdAt   DateTime @default(now())

  @@unique([provider, model])
}

model Document {
  id        String   @id @default(cuid())
  projectId String?
  kind      String   @default("link")
  title     String
  phase     String?
  url       String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model NotificationRule {
  id        String   @id @default(cuid())
  event     String
  condition String
  channel   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TimerSession {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  startedAt DateTime @default(now())

  @@index([taskId])
}
