diff --git a/apps/web/src/features/time-entries/components/YesterdayTimeline.tsx b/apps/web/src/features/time-entries/components/YesterdayTimeline.tsx
new file mode 100644
index 0000000..bc8c390
--- /dev/null
+++ b/apps/web/src/features/time-entries/components/YesterdayTimeline.tsx
@@ -0,0 +1,32 @@
+import { useTranslation } from "react-i18next";
+import { Panel } from "../../../components/Panel";
+import { useDayEntries } from "../api/use-today-entries";
+import { EntriesTimeline } from "./EntriesTimeline";
+import { formatMinutes } from "../../../lib/format-minutes";
+
+const pad = (n: number) => String(n).padStart(2, "0");
+const round2 = (n: number) => Math.round(n * 100) / 100;
+
+function yesterday(): Date {
+  const d = new Date();
+  d.setDate(d.getDate() - 1);
+  return d;
+}
+
+const isoDate = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+
+export function YesterdayTimeline() {
+  const { t, i18n } = useTranslation();
+  const day = yesterday();
+  const { data: entries = [] } = useDayEntries(isoDate(day));
+  const minutes = entries.reduce((s, e) => s + e.minutes, 0);
+  const cost = round2(entries.reduce((s, e) => s + e.cost, 0));
+  const ai = round2(entries.reduce((s, e) => s + e.aiCost, 0));
+  const date = day.toLocaleDateString(i18n.language, { weekday: "short", day: "2-digit", month: "2-digit" });
+
+  return (
+    <Panel title={t("tracker.yesterdayPanel", { date, time: formatMinutes(minutes), cost, ai })}>
+      <EntriesTimeline entries={entries} emptyLabel={t("tracker.emptyYesterday")} />
+    </Panel>
+  );
+}
