--- /dev/null
+++ b/apps/web/src/lib/format-minutes.ts
@@ -0,0 +1,6 @@
+export function formatMinutes(minutes: number): string {
+  if (minutes === 0) return "—";
+  const h = Math.floor(minutes / 60);
+  const m = minutes % 60;
+  return h > 0 ? `${h}h ${String(m).padStart(2, "0")}m` : `${m}m`;
+}
